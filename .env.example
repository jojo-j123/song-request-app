# Leave both empty to run in LOCAL mode (localStorage + cross-tab realtime, single device).
# Fill both to run in SUPABASE mode (multi-device, production).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: public base URL used for the QR code (e.g. https://encore.yourdomain.com).
# Defaults to the current browser origin.
VITE_PUBLIC_URL=
